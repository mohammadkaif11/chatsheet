generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WaitlistUser {
  id        String   @id @default(cuid())
  contact   String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model DemoRequest {
  id        String   @id @default(cuid())
  name      String
  company   String
  email     String
  phone     String
  message   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
